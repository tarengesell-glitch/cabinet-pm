        { "key": "top_trim_style", "type": "image", "label": "Top trim style", "short": "Top trim", "art": "top_trim", "fidelity": "photo", "aspect": "10/3", "size": "sm", "min": "220px", "sample": true, "options": [
          { "id": "flat_band", "label": "Flat band" }, { "id": "crown", "label": "Crown" }, { "id": "stepped_crown", "label": "Stepped crown" }
        ] },
