          { "id": "flat", "label": "Flat" }, { "id": "shaped", "label": "Shaped" }, { "id": "hidden", "label": "Hidden" }
        ] },
        { "key": "light_valance_colour", "type": "chips", "label": "Colour", "short": "Valance colour", "source": "trim_colours",
